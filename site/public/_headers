# Cloudflare Pages caching rules.
# Hashed asset files are immutable — cache them aggressively at the edge and in the browser.
# HTML must never be stale: a new deploy needs to be visible immediately.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate
